# Required LiveKit/SIP settings. Keep real values in the ignored .env file.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIP_OUTBOUND_TRUNK_ID=
CALLER_NUMBER=
ENABLE_LIVE_CALLS=true

# Current separate pipeline models (LiveKit Inference)
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02

# Optional post-call audio transcription and semantic evaluation only.
# This key is not used for live conversation generation.
OPENAI_API_KEY=
